@startuml
!theme plain
skinparam backgroundColor #FDFDFD
skinparam ActivityBackgroundColor #FFE6CC
skinparam ActivityBorderColor #D79B00
skinparam ActivityDiamondBackgroundColor #E1D5E7
skinparam ActivityDiamondBorderColor #9673A6
skinparam ArrowColor #666666
skinparam defaultFontName Arial

|#F8CECC|Admin|
start
:Pilih Menu Daftar Pengajuan Surat;
:Pilih Salah Satu Pengajuan (Status Menunggu);
:Periksa Kelengkapan Data;

if (Data Disetujui?) then (Ya)
  :Input Nomor Surat;
  :Upload File Surat Hasil (PDF);
  :Klik Setujui;
  |#D5E8D4|Sistem|
  :Ubah Status Menjadi "Selesai";
  :Simpan File PDF dan Nomor Surat;
else (Tidak)
  |#F8CECC|Admin|
  :Isi Alasan Penolakan;
  :Klik Tolak;
  |#D5E8D4|Sistem|
  :Ubah Status Menjadi "Ditolak";
  :Simpan Alasan Penolakan;
endif
:Kirim Notifikasi ke Warga;
stop
@enduml
