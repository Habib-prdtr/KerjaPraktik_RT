@startuml
!theme plain
skinparam backgroundColor #FDFDFD
skinparam defaultFontName Arial
autonumber

skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #6C8EBF
  LifeLineBackgroundColor #DAE8FC
  ParticipantPadding 40
  BoxPadding 40
}
skinparam actor {
  BackgroundColor<<Warga>> #DAE8FC
  BorderColor<<Warga>> #6C8EBF
  BackgroundColor<<Admin>> #F8CECC
  BorderColor<<Admin>> #B85450
}
skinparam boundary {
  BackgroundColor #D5E8D4
  BorderColor #82B366
}
skinparam control {
  BackgroundColor #D5E8D4
  BorderColor #82B366
}
skinparam entity {
  BackgroundColor #FFE6CC
  BorderColor #D79B00
}
skinparam database {
  BackgroundColor #E1D5E7
  BorderColor #9673A6
}

actor "Admin" as Admin <<Admin>>
boundary "Halaman Validasi Surat" as View
control "SuratAdminController" as Controller
entity "Surat (Model)" as Model
database "Database" as DB

Admin -> View : Input No Surat, Upload PDF, & Setujui
activate View
View -> Controller : POST /admin/surat/{id}/approve
activate Controller

Controller -> Controller : Simpan File PDF Surat

Controller -> Model : update(status='Selesai')
activate Model
Model -> DB : UPDATE surat
activate DB
DB --> Model : OK
deactivate DB
Model --> Controller : Success
deactivate Model

Controller --> View : Redirect & Notifikasi
View --> Admin : Pesan Surat Disetujui & Di-upload
deactivate Controller
deactivate View
@enduml
