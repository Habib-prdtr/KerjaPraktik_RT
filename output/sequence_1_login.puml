@startuml
!theme plain
skinparam backgroundColor #FDFDFD
skinparam defaultFontName Arial
autonumber

skinparam sequence {
  ArrowColor #333333
  LifeLineBorderColor #6C8EBF
  LifeLineBackgroundColor #DAE8FC
  ParticipantPadding 40
  BoxPadding 40
}
skinparam actor {
  BackgroundColor<<Warga>> #DAE8FC
  BorderColor<<Warga>> #6C8EBF
  BackgroundColor<<Admin>> #F8CECC
  BorderColor<<Admin>> #B85450
}
skinparam boundary {
  BackgroundColor #D5E8D4
  BorderColor #82B366
}
skinparam control {
  BackgroundColor #D5E8D4
  BorderColor #82B366
}
skinparam entity {
  BackgroundColor #FFE6CC
  BorderColor #D79B00
}
skinparam database {
  BackgroundColor #E1D5E7
  BorderColor #9673A6
}

actor "Pengguna (Warga/Admin)" as User <<Warga>>
boundary "Halaman Login" as View
control "AuthController" as Controller
entity "User (Model)" as Model
database "Database" as DB

User -> View : Input NIK/Username & Password
activate View
View -> Controller : POST /login
activate Controller
Controller -> DB : Cek Kredensial User
activate DB
DB --> Controller : Data User (Jika Valid)
deactivate DB

alt Kredensial Valid
    Controller -> Controller : Buat Session / Token
    Controller --> View : Redirect ke Dashboard
    View --> User : Tampilkan Halaman Utama
else Kredensial Tidak Valid
    Controller --> View : Return Error
    View --> User : Tampilkan Pesan Error
end
deactivate Controller
deactivate View
@enduml
